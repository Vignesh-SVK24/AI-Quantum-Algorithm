# Quantum Platform Frontend Environment Configuration
# If left empty in local development, the frontend defaults to http://127.0.0.1:8000
# For production deployments (e.g. Render, Railway, Fly.io), set your HTTPS API domain:
VITE_API_BASE_URL=

# Supabase Auth & Storage Configuration (Project Settings -> API)
# The Anon key is public-safe and used by the client browser for Supabase Auth & RLS.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
