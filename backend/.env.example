# Quantum Algorithm Learning Platform — Environment Variables
# NEVER commit real keys or production secrets to source control.

# Google Gemini API Key for AI Tutor & Simulator Diagnostics
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily AI Web Research Engine Key (https://tavily.com)
# Used by the Autonomous Quantum Research Agent for live grounding against
# IBM Quantum, Google Quantum AI, Nature, arXiv, and Qiskit documentation.
# If omitted or invalid, the platform automatically utilizes academic arXiv & Wikipedia fallback.
TAVILY_API_KEY=your_tavily_api_key_here

# Supabase PostgreSQL Database Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_secret_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
DATABASE_URL=postgresql://postgres:your_password@db.your-project-id.supabase.co:5432/postgres
